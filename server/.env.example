# Required for real news (without it the site serves whatever is already stored)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional
# AI_MODEL=claude-haiku-4-5-20251001
# DATA_DIR=./data            # use /data in production, on a persistent volume
# ADMIN_TOKEN=               # enables POST /api/admin/refresh (x-admin-token header); skips cooldown and cap
# REFRESH_MIN_INTERVAL_MIN=5   # shared cooldown between refreshes (minutes)
# REFRESH_MAX_PER_DAY=24       # cap on refresh runs per UTC day
# PORT=3000
